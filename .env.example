# Open Immune Intelligence web application
OPEN_II_APP_ORIGIN=https://open-ii.scaniom.com
OPEN_II_SESSION_SECRET=
OPEN_II_SESSION_MAX_AGE_SECONDS=43200
OPEN_II_VERSION=0.1.0

# Optional deployment-managed profiles. Browser-created profiles cannot opt into
# private-network reachability or custom CA trust.
OPEN_II_PROFILES_JSON=[]
OPEN_II_HOST_PROFILE_MAP_JSON={"open-ii.scaniom.com":"cloud"}
# Company-host example (requires a matching server profile in OPEN_II_PROFILES_JSON):
# OPEN_II_HOST_PROFILE_MAP_JSON={"open-ii.scaniom.com":"cloud","company.scaniom.com":"company"}
OPEN_II_CONTROL_HOST_ALLOWLIST=
# OPEN_II_PROFILES_JSON example for an enterprise deployment:
# [{"name":"company","label":"Company Private","type":"private-enterprise","controlUrl":"https://control.company.example","allowPrivateNetwork":true,"caEnv":"COMPANY_CONTROL_CA_PEM"}]
# COMPANY_CONTROL_CA_PEM=

# Public Scaniom demo / CLI contract
SCANIOM_CONTROL_URL=https://control.scaniom.com
SCANIOM_PROFILE=cloud
SCANIOM_PROFILE_TYPE=cloud
SCANIOM_CA_FILE=
SCANIOM_VERSION=0.4.1
SCANIOM_RELEASE=R18
SCANIOM_ENVIRONMENT=scaniom-demo-production
SCANIOM_WORKLOAD=scaniom-demo-agent
SCANIOM_NODE_NAME=scaniom-demo-node
SCANIOM_NODE_URL=http://127.0.0.1:8787
SCANIOM_MODEL=gpt-5-mini
